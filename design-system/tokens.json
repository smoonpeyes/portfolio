{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Layla Portfolio Design System",
    "version": "1.0.0",
    "description": "Design tokens for the Layla UX Designer Portfolio — Muted Surf palette with Plus Jakarta Sans typography.",
    "author": "Layla — Principal UX Designer",
    "lastModified": "2026-03-03",
    "tokenSets": ["color", "typography", "spacing", "borderRadius", "shadow", "motion", "breakpoint"]
  },

  "color": {
    "$description": "Full color system: brand palettes, semantic states, neutrals, and dark mode equivalents.",

    "slate": {
      "$description": "Primary brand color — deep slate. Used for headers, backgrounds, and strong UI anchors.",
      "50":  { "$value": "#f0f0f5", "$type": "color", "$description": "Lightest slate tint — backgrounds, hover surfaces" },
      "100": { "$value": "#d9d9e8", "$type": "color", "$description": "Very light slate — subtle dividers, borders" },
      "200": { "$value": "#b3b3d1", "$type": "color", "$description": "Light slate — disabled states, placeholders" },
      "300": { "$value": "#8c8cba", "$type": "color", "$description": "Muted slate — icons on light backgrounds" },
      "400": { "$value": "#6666a3", "$type": "color", "$description": "Mid slate — secondary labels" },
      "500": { "$value": "#3d3d5c", "$type": "color", "$description": "Base slate — hero backgrounds, nav, primary text anchor" },
      "600": { "$value": "#33334f", "$type": "color", "$description": "Darker slate — hover on slate elements" },
      "700": { "$value": "#282842", "$type": "color", "$description": "Dark slate — pressed states" },
      "800": { "$value": "#1e1e30", "$type": "color", "$description": "Very dark slate — deep backgrounds" },
      "900": { "$value": "#14141f", "$type": "color", "$description": "Darkest slate — near black" }
    },

    "pink": {
      "$description": "Secondary / CTA color — vibrant pink. Used for primary actions, links, and emphasis.",
      "50":  { "$value": "#fef1f7", "$type": "color", "$description": "Lightest pink tint — alert backgrounds, hover surfaces" },
      "100": { "$value": "#fcd3e8", "$type": "color", "$description": "Very light pink — badges, chips" },
      "200": { "$value": "#f9a7d1", "$type": "color", "$description": "Light pink — decorative use" },
      "300": { "$value": "#f57bba", "$type": "color", "$description": "Muted pink — icon fills" },
      "400": { "$value": "#ee4fa2", "$type": "color", "$description": "Mid pink — secondary accents" },
      "500": { "$value": "#E63980", "$type": "color", "$description": "Base pink — primary CTA, interactive accent" },
      "600": { "$value": "#cc2f6f", "$type": "color", "$description": "Hover pink — button hover states" },
      "700": { "$value": "#a8245e", "$type": "color", "$description": "Dark pink — pressed states" },
      "800": { "$value": "#841a4d", "$type": "color", "$description": "Deeper pink — dark mode accents" },
      "900": { "$value": "#60103c", "$type": "color", "$description": "Darkest pink — high contrast mode" }
    },

    "seafoam": {
      "$description": "Accent color — vibrant seafoam green. Used for success states, footer accents, and highlights.",
      "50":  { "$value": "#e6fdf8", "$type": "color", "$description": "Lightest seafoam — success alert backgrounds" },
      "100": { "$value": "#b3f6e8", "$type": "color", "$description": "Very light seafoam — success badges" },
      "200": { "$value": "#80eed8", "$type": "color", "$description": "Light seafoam — decorative fills" },
      "300": { "$value": "#4de7c8", "$type": "color", "$description": "Muted seafoam — icon accents" },
      "400": { "$value": "#1adeb8", "$type": "color", "$description": "Mid seafoam — secondary highlights" },
      "500": { "$value": "#00D9A3", "$type": "color", "$description": "Base seafoam — footer link hover, success states" },
      "600": { "$value": "#00b589", "$type": "color", "$description": "Darker seafoam — hover states" },
      "700": { "$value": "#00916e", "$type": "color", "$description": "Dark seafoam — pressed states, teal-dark" },
      "800": { "$value": "#006d53", "$type": "color", "$description": "Deep seafoam — dark surfaces" },
      "900": { "$value": "#004937", "$type": "color", "$description": "Darkest seafoam — high contrast" }
    },

    "purple": {
      "$description": "Tertiary accent — deep purple. Used for inline links (AAA contrast on cream).",
      "50":  { "$value": "#f3eef9", "$type": "color", "$description": "Lightest purple — info alert backgrounds" },
      "100": { "$value": "#e0d0f2", "$type": "color", "$description": "Very light purple — info badges" },
      "200": { "$value": "#c1a1e5", "$type": "color", "$description": "Light purple — decorative" },
      "300": { "$value": "#a272d8", "$type": "color", "$description": "Muted purple — icon fills" },
      "400": { "$value": "#7e45c3", "$type": "color", "$description": "Mid purple — secondary links" },
      "500": { "$value": "#5B2A86", "$type": "color", "$description": "Base purple — inline links (8.2:1 on cream)" },
      "600": { "$value": "#4d2472", "$type": "color", "$description": "Darker purple — hover states" },
      "700": { "$value": "#3e1d5e", "$type": "color", "$description": "Dark purple — pressed states" },
      "800": { "$value": "#2f164a", "$type": "color", "$description": "Deep purple — dark surfaces" },
      "900": { "$value": "#200f36", "$type": "color", "$description": "Darkest purple — high contrast" }
    },

    "neutral": {
      "$description": "Neutral / gray scale. Warm-tinted to harmonize with the cream background.",
      "0":    { "$value": "#ffffff", "$type": "color", "$description": "Pure white — card backgrounds" },
      "50":   { "$value": "#FFF8F0", "$type": "color", "$description": "Warm cream — main page background" },
      "100":  { "$value": "#f5efe8", "$type": "color", "$description": "Light warm gray — section backgrounds" },
      "200":  { "$value": "#e8e1d9", "$type": "color", "$description": "Subtle border color — dividers" },
      "300":  { "$value": "#d4cdc5", "$type": "color", "$description": "Border color — form inputs, cards" },
      "400":  { "$value": "#b0a9a1", "$type": "color", "$description": "Muted — placeholder text" },
      "500":  { "$value": "#8c857d", "$type": "color", "$description": "Mid gray — icons, captions" },
      "600":  { "$value": "#666666", "$type": "color", "$description": "Secondary text — metadata, captions" },
      "700":  { "$value": "#4a4444", "$type": "color", "$description": "Body text on light surfaces" },
      "800":  { "$value": "#333333", "$type": "color", "$description": "Near-black text" },
      "900":  { "$value": "#2d2d2d", "$type": "color", "$description": "Charcoal — primary text, footer background" },
      "950":  { "$value": "#1a1a1a", "$type": "color", "$description": "Deep charcoal — dark backgrounds" },
      "1000": { "$value": "#000000", "$type": "color", "$description": "Pure black — high contrast text" }
    },

    "semantic": {
      "$description": "Purpose-specific colors for feedback states.",
      "success": {
        "subtle":  { "$value": "#e6fdf8", "$type": "color" },
        "base":    { "$value": "#00917a", "$type": "color", "$description": "Meets AA on white (4.7:1)" },
        "strong":  { "$value": "#00715e", "$type": "color" }
      },
      "warning": {
        "subtle":  { "$value": "#fef8e6", "$type": "color" },
        "base":    { "$value": "#b45309", "$type": "color", "$description": "Meets AA on white (4.6:1)" },
        "strong":  { "$value": "#92400e", "$type": "color" }
      },
      "error": {
        "subtle":  { "$value": "#fee2e2", "$type": "color" },
        "base":    { "$value": "#dc2626", "$type": "color", "$description": "Meets AA on white (5.1:1)" },
        "strong":  { "$value": "#991b1b", "$type": "color" }
      },
      "info": {
        "subtle":  { "$value": "#f3eef9", "$type": "color" },
        "base":    { "$value": "#5B2A86", "$type": "color", "$description": "Meets AAA on white (8.2:1)" },
        "strong":  { "$value": "#3e1d5e", "$type": "color" }
      }
    },

    "darkMode": {
      "$description": "Dark mode equivalents for all semantic roles. Apply via [data-theme='dark'] attribute.",
      "background": {
        "base":      { "$value": "#14141f", "$type": "color", "$description": "Page background" },
        "elevated":  { "$value": "#1e1e30", "$type": "color", "$description": "Card, modal backgrounds" },
        "overlay":   { "$value": "#282842", "$type": "color", "$description": "Dropdown, popover backgrounds" },
        "sunken":    { "$value": "#0d0d18", "$type": "color", "$description": "Input fields, code blocks" }
      },
      "text": {
        "primary":   { "$value": "#FFF8F0", "$type": "color", "$description": "Main text on dark backgrounds" },
        "secondary":  { "$value": "#b0a9a1", "$type": "color", "$description": "Muted text, metadata" },
        "disabled":  { "$value": "#666666", "$type": "color" },
        "inverse":   { "$value": "#2d2d2d", "$type": "color", "$description": "Text on light elements in dark mode" }
      },
      "border": {
        "subtle":    { "$value": "#282842", "$type": "color" },
        "base":      { "$value": "#33334f", "$type": "color" },
        "strong":    { "$value": "#4a4a6a", "$type": "color" }
      },
      "brand": {
        "primary":   { "$value": "#f57bba", "$type": "color", "$description": "Pink shifted lighter for dark surfaces (4.8:1 on dark bg)" },
        "secondary":  { "$value": "#4de7c8", "$type": "color", "$description": "Seafoam shifted lighter" },
        "tertiary":  { "$value": "#c1a1e5", "$type": "color", "$description": "Purple shifted lighter" }
      }
    },

    "alias": {
      "$description": "Semantic aliases mapping roles to palette values. Reference these in components.",
      "background":      { "$value": "{color.neutral.50}",      "$type": "color" },
      "surface":         { "$value": "{color.neutral.0}",       "$type": "color" },
      "surfaceAlt":      { "$value": "{color.neutral.100}",     "$type": "color" },
      "textPrimary":     { "$value": "{color.neutral.900}",     "$type": "color" },
      "textSecondary":   { "$value": "{color.neutral.600}",     "$type": "color" },
      "textInverse":     { "$value": "{color.neutral.50}",      "$type": "color" },
      "textLink":        { "$value": "{color.purple.500}",      "$type": "color" },
      "textLinkHover":   { "$value": "{color.pink.500}",        "$type": "color" },
      "borderDefault":   { "$value": "{color.neutral.300}",     "$type": "color" },
      "borderSubtle":    { "$value": "{color.neutral.200}",     "$type": "color" },
      "brand":           { "$value": "{color.slate.500}",       "$type": "color" },
      "brandAccent":     { "$value": "{color.pink.500}",        "$type": "color" },
      "brandHighlight":  { "$value": "{color.seafoam.500}",     "$type": "color" },
      "focusRing":       { "$value": "{color.pink.500}",        "$type": "color" }
    }
  },

  "typography": {
    "$description": "Type system — Plus Jakarta Sans with a 9-step modular scale (Major Third, 1.25 ratio).",

    "fontFamily": {
      "primary": {
        "$value": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Primary humanist sans-serif. Chosen for warmth, legibility, and modern personality that complements the portfolio's creative UX focus."
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Courier New', monospace",
        "$type": "fontFamily",
        "$description": "Monospace for code blocks and technical labels."
      }
    },

    "fontSize": {
      "$description": "9-step type scale. Base: 16px (1rem). Ratio: Major Third (1.25). Steps below base use 0.8 ratio.",
      "step1":  { "$value": "0.64rem",  "$type": "dimension", "$description": "~10px — Fine print, legal, footnotes" },
      "step2":  { "$value": "0.75rem",  "$type": "dimension", "$description": "~12px — Labels, meta-labels, captions, tag text" },
      "step3":  { "$value": "0.875rem", "$type": "dimension", "$description": "~14px — Small body, footnotes, card meta" },
      "step4":  { "$value": "1rem",     "$type": "dimension", "$description": "~16px — Base body copy (root em)" },
      "step5":  { "$value": "1.25rem",  "$type": "dimension", "$description": "~20px — Large body, lead paragraphs, h4" },
      "step6":  { "$value": "1.563rem", "$type": "dimension", "$description": "~25px — H3 / subheadings" },
      "step7":  { "$value": "1.953rem", "$type": "dimension", "$description": "~31px — H2 / section titles" },
      "step8":  { "$value": "2.441rem", "$type": "dimension", "$description": "~39px — H1 / page titles" },
      "step9":  { "$value": "3.052rem", "$type": "dimension", "$description": "~49px — Display / hero headings" },
      "display":{ "$value": "3.815rem", "$type": "dimension", "$description": "~61px — Large display text" },
      "hero":   { "$value": "4.768rem", "$type": "dimension", "$description": "~76px — Hero/super-display (fluid with clamp)" }
    },

    "fontWeight": {
      "regular":   { "$value": "400", "$type": "fontWeight", "$description": "Body copy, secondary content" },
      "medium":    { "$value": "500", "$type": "fontWeight", "$description": "Emphasis, subtitles, labels" },
      "semibold":  { "$value": "600", "$type": "fontWeight", "$description": "Navigation, buttons, UI labels" },
      "bold":      { "$value": "700", "$type": "fontWeight", "$description": "Headings, stats, strong emphasis" }
    },

    "lineHeight": {
      "none":    { "$value": "1",   "$type": "number", "$description": "Single line display text" },
      "tight":   { "$value": "1.2", "$type": "number", "$description": "Headings, large text" },
      "snug":    { "$value": "1.4", "$type": "number", "$description": "Short paragraphs, cards" },
      "base":    { "$value": "1.7", "$type": "number", "$description": "Body copy default" },
      "relaxed": { "$value": "1.8", "$type": "number", "$description": "Long-form text, about page" }
    },

    "letterSpacing": {
      "tight":   { "$value": "-0.02em", "$type": "dimension", "$description": "Large display headings" },
      "normal":  { "$value": "0",       "$type": "dimension", "$description": "Default" },
      "wide":    { "$value": "0.04em",  "$type": "dimension", "$description": "Uppercase labels" },
      "wider":   { "$value": "0.08em",  "$type": "dimension", "$description": "Small caps, meta labels" },
      "widest":  { "$value": "0.16em",  "$type": "dimension", "$description": "Tracking labels, badges" }
    },

    "fontPairingRationale": {
      "$description": "Plus Jakarta Sans operates as both heading and body typeface — a deliberate single-family strategy. Its geometric structure (humanist terminals, optical letter spacing) gives headings authority while remaining highly readable at body sizes. The type scale uses a Major Third ratio (1.25x) which creates clear visual hierarchy without the aggressive size jumps of a golden ratio. At display sizes, negative letter-spacing (-0.02em) tightens large headlines. At body sizes, generous line-height (1.7–1.8) ensures readability for long-form case study content."
    }
  },

  "spacing": {
    "$description": "8px grid system. All values are multiples of 0.5rem (8px). Named tokens map to usage contexts.",
    "0":   { "$value": "0",      "$type": "dimension" },
    "px":  { "$value": "1px",    "$type": "dimension" },
    "0.5": { "$value": "0.25rem","$type": "dimension", "$description": "4px — Tight icon margins" },
    "1":   { "$value": "0.5rem", "$type": "dimension", "$description": "8px — space-xs: icon gaps, badge padding" },
    "1.5": { "$value": "0.75rem","$type": "dimension", "$description": "12px — compact spacing" },
    "2":   { "$value": "1rem",   "$type": "dimension", "$description": "16px — space-sm: paragraph margins, button gaps" },
    "3":   { "$value": "1.5rem", "$type": "dimension", "$description": "24px — space-md: card padding, form fields" },
    "4":   { "$value": "2rem",   "$type": "dimension", "$description": "32px — space-lg: card grid gap, section padding" },
    "6":   { "$value": "3rem",   "$type": "dimension", "$description": "48px — space-xl: large section gaps" },
    "8":   { "$value": "4rem",   "$type": "dimension", "$description": "64px — space-2xl: section vertical padding" },
    "10":  { "$value": "5rem",   "$type": "dimension", "$description": "80px — generous section breathing room" },
    "12":  { "$value": "6rem",   "$type": "dimension", "$description": "96px — space-3xl: page-level section gaps" },
    "16":  { "$value": "8rem",   "$type": "dimension", "$description": "128px — hero padding on large screens" },
    "20":  { "$value": "10rem",  "$type": "dimension", "$description": "160px — maximum section padding" }
  },

  "borderRadius": {
    "none":  { "$value": "0",       "$type": "dimension" },
    "xs":    { "$value": "2px",     "$type": "dimension", "$description": "Tags, inline elements" },
    "sm":    { "$value": "4px",     "$type": "dimension", "$description": "Input fields, small chips" },
    "base":  { "$value": "8px",     "$type": "dimension", "$description": "Cards, buttons, panels — system default" },
    "md":    { "$value": "12px",    "$type": "dimension", "$description": "Large cards, modals" },
    "lg":    { "$value": "16px",    "$type": "dimension", "$description": "Drawers, featured cards" },
    "xl":    { "$value": "24px",    "$type": "dimension", "$description": "Pills, floating elements" },
    "2xl":   { "$value": "32px",    "$type": "dimension", "$description": "Decorative shapes" },
    "full":  { "$value": "9999px",  "$type": "dimension", "$description": "Circles, pill buttons, avatars" }
  },

  "shadow": {
    "xs":      { "$value": "0 1px 2px rgba(0,0,0,0.04)",                        "$type": "shadow", "$description": "Subtle lift — tags, chips" },
    "sm":      { "$value": "0 2px 6px rgba(0,0,0,0.06)",                        "$type": "shadow", "$description": "Input focus, subtle card" },
    "md":      { "$value": "0 4px 20px rgba(0,0,0,0.08)",                       "$type": "shadow", "$description": "Card default" },
    "lg":      { "$value": "0 8px 30px rgba(0,0,0,0.12)",                       "$type": "shadow", "$description": "Card hover, modal" },
    "xl":      { "$value": "0 16px 48px rgba(0,0,0,0.16)",                      "$type": "shadow", "$description": "Drawer, overlay panels" },
    "2xl":     { "$value": "0 24px 64px rgba(0,0,0,0.2)",                       "$type": "shadow", "$description": "Full-screen overlays" },
    "pink":    { "$value": "0 4px 12px rgba(230, 57, 128, 0.3)",               "$type": "shadow", "$description": "Primary button hover" },
    "slate":   { "$value": "0 4px 12px rgba(61, 61, 92, 0.3)",                 "$type": "shadow", "$description": "Secondary button hover" },
    "seafoam": { "$value": "0 4px 12px rgba(0, 217, 163, 0.3)",                "$type": "shadow", "$description": "Accent element hover" },
    "inner":   { "$value": "inset 0 2px 4px rgba(0,0,0,0.06)",                 "$type": "shadow", "$description": "Input field pressed" },
    "focus":   { "$value": "0 0 0 3px rgba(230, 57, 128, 0.35)",               "$type": "shadow", "$description": "Focus ring — 3px offset ring" }
  },

  "motion": {
    "$description": "Motion principles: UI motion is purposeful and restrained. Micro-interactions reinforce affordances without distracting from content. All durations comply with prefers-reduced-motion.",

    "duration": {
      "instant":  { "$value": "50ms",  "$type": "duration", "$description": "Tooltip show, icon swap" },
      "fast":     { "$value": "100ms", "$type": "duration", "$description": "Button press feedback" },
      "normal":   { "$value": "200ms", "$type": "duration", "$description": "Nav links, badge transitions" },
      "moderate": { "$value": "300ms", "$type": "duration", "$description": "Card hover, input focus — system default" },
      "slow":     { "$value": "500ms", "$type": "duration", "$description": "Modal open/close, page reveals" },
      "slower":   { "$value": "700ms", "$type": "duration", "$description": "Hero entrance animations" }
    },

    "easing": {
      "linear":      { "$value": "linear",                        "$type": "cubicBezier", "$description": "Progress bars, skeleton loaders" },
      "easeIn":      { "$value": "cubic-bezier(0.4, 0, 1, 1)",   "$type": "cubicBezier", "$description": "Elements leaving the screen" },
      "easeOut":     { "$value": "cubic-bezier(0, 0, 0.2, 1)",   "$type": "cubicBezier", "$description": "Elements entering — default for UI feedback" },
      "easeInOut":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Bidirectional motion — toggles, drawers" },
      "spring":      { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Playful bounce — card hovers, FABs" },
      "expressive":  { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Expressive opens — modals, sheets" }
    },

    "preset": {
      "$description": "Named motion presets combining duration + easing for common interactions.",
      "micro":      { "$value": "50ms cubic-bezier(0, 0, 0.2, 1)",  "$description": "Instant feedback: badges, chips" },
      "buttonPress":{ "$value": "100ms cubic-bezier(0, 0, 0.2, 1)", "$description": "Button press, icon swap" },
      "linkHover":  { "$value": "200ms cubic-bezier(0, 0, 0.2, 1)", "$description": "Nav underline, color change" },
      "cardHover":  { "$value": "300ms cubic-bezier(0.34, 1.56, 0.64, 1)", "$description": "Card lift with spring" },
      "modalOpen":  { "$value": "500ms cubic-bezier(0.16, 1, 0.3, 1)", "$description": "Modal/drawer entrance" },
      "pageReveal": { "$value": "700ms cubic-bezier(0, 0, 0.2, 1)", "$description": "Section fade-ins on scroll" }
    }
  },

  "breakpoint": {
    "$description": "Responsive breakpoint system. Mobile-first (min-width). Breakpoints align with major device classes.",
    "xs":  { "$value": "320px",  "$type": "dimension", "$description": "Very small mobile" },
    "sm":  { "$value": "480px",  "$type": "dimension", "$description": "Mobile portrait" },
    "md":  { "$value": "768px",  "$type": "dimension", "$description": "Tablet — primary layout switch" },
    "lg":  { "$value": "1024px", "$type": "dimension", "$description": "Desktop / landscape tablet" },
    "xl":  { "$value": "1200px", "$type": "dimension", "$description": "Wide desktop — max-width container" },
    "2xl": { "$value": "1440px", "$type": "dimension", "$description": "Large desktop" },
    "3xl": { "$value": "1920px", "$type": "dimension", "$description": "Ultra-wide" }
  },

  "zIndex": {
    "below":   { "$value": "-1",  "$type": "number" },
    "base":    { "$value": "0",   "$type": "number" },
    "raised":  { "$value": "10",  "$type": "number", "$description": "Sticky elements, subtle overlays" },
    "nav":     { "$value": "50",  "$type": "number", "$description": "Primary navigation" },
    "dropdown":{ "$value": "100", "$type": "number", "$description": "Dropdowns, tooltips" },
    "modal":   { "$value": "200", "$type": "number", "$description": "Modals, dialogs" },
    "toast":   { "$value": "300", "$type": "number", "$description": "Toast notifications" },
    "top":     { "$value": "9999","$type": "number", "$description": "Skip links, critical overlays" }
  }
}
